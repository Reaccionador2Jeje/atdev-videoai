{
  "openapi": "3.1.0",
  "info": {
    "title": "AtDev VideoAI GPT Actions",
    "version": "1.0.0",
    "description": "Create editable motion-graphics video projects and render MP4 files with AtDev VideoAI. The renderer uses FFmpeg; it does not synthesize AI footage or voice."
  },
  "servers": [
    { "url": "https://atdev-videoai-production.up.railway.app" }
  ],
  "components": {
    "securitySchemes": {
      "AtDevApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-AtDev-API-Key"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "description": "Declarative AtDev VideoAI project. Provide a name, format and scenes. Formats: 16:9, 9:16 or 1:1. Each scene supports title, subtitle, duration, background, image, animation and transition. Optional assets and audioTracks may be included.",
        "properties": {
          "name": { "type": "string" },
          "format": { "type": "string", "enum": ["16:9", "9:16", "1:1"] },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "duration": { "type": "number", "minimum": 1, "maximum": 30 },
                "background": { "type": "string", "description": "Hex color, e.g. #18221d" },
                "image": { "type": "string" },
                "animation": { "type": "string", "enum": ["none", "zoom-in", "zoom-out", "fade-in"] },
                "transition": { "type": "string", "enum": ["cut", "fade"] }
              },
              "additionalProperties": true
            }
          },
          "assets": { "type": "object", "additionalProperties": true },
          "audioTracks": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        },
        "required": ["scenes"],
        "additionalProperties": true
      },
      "CreateProjectRequest": {
        "type": "object",
        "properties": {
          "project": { "$ref": "#/components/schemas/Project" },
          "render": { "type": "boolean", "default": false, "description": "Render an MP4 immediately after saving. Only set true when the user asks for the exported video." }
        },
        "required": ["project"],
        "additionalProperties": false
      }
    }
  },
  "security": [{ "AtDevApiKey": [] }],
  "paths": {
    "/actions/v1/health": {
      "get": {
        "operationId": "checkVideoAIHealth",
        "summary": "Check AtDev VideoAI rendering engine",
        "description": "Check whether the FFmpeg rendering engine is online before creating or rendering a video.",
        "responses": { "200": { "description": "Engine health status" }, "401": { "description": "Invalid API key" }, "503": { "description": "API key not configured on server" } }
      }
    },
    "/actions/v1/projects": {
      "get": {
        "operationId": "listVideoProjects",
        "summary": "List saved video projects",
        "responses": { "200": { "description": "Saved projects" }, "401": { "description": "Invalid API key" } }
      },
      "post": {
        "operationId": "createVideoProject",
        "summary": "Create a video project and optionally render it",
        "description": "Convert the user's request into a declarative project object with scenes. Save it as an editable project. Set render=true only when the user explicitly asks for the MP4 now. The output includes project_id; when rendered it includes a temporary download_url.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProjectRequest" } } }
        },
        "responses": { "201": { "description": "Project created; render result included when requested" }, "400": { "description": "Invalid project request" }, "401": { "description": "Invalid API key" }, "422": { "description": "Project creation or render failed" } }
      }
    },
    "/actions/v1/projects/{project_id}/render": {
      "post": {
        "operationId": "renderVideoProject",
        "summary": "Render a saved video project to MP4",
        "parameters": [{ "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9]{12}$" } }],
        "responses": { "200": { "description": "Rendered MP4 and temporary download URL" }, "401": { "description": "Invalid API key" }, "422": { "description": "Render failed or project not found" } }
      }
    },
    "/actions/v1/renders/{filename}/download": {
      "get": {
        "operationId": "getVideoDownload",
        "summary": "Get a temporary MP4 download URL",
        "description": "Returns a signed HTTPS URL that expires after 15 minutes.",
        "parameters": [{ "name": "filename", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^video-[a-f0-9]{12}\\.mp4$" } }],
        "responses": { "200": { "description": "Temporary download URL" }, "401": { "description": "Invalid API key" }, "404": { "description": "Rendered file not found" } }
      }
    }
  }
}
